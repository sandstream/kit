# editor/cloud-sync conflict copies ("filename 2.ext"). The suffix is not always
# " 2" — iCloud/Dropbox count upward (" 3", " 5", …), and they land on .d.ts and
# .json too, so match any single digit rather than just 2. Extensionless hook
# copies (".githooks/post-commit 2") get the same treatment.
*\ [0-9].ts
*\ [0-9].js
*\ [0-9].mjs
*\ [0-9].md
*\ [0-9].json
*\ [0-9].toml
.githooks/*\ [0-9]

# Generated by the publish workflow to name the SBOM root component.
.syft.yaml

# ── kit security check-gitignore ── do not edit ──
# kit local state (elevation, env, runtime)
.kit/*
# keep curated shared memory tracked (committed by design)
!.kit/shared/
# private keys
*.key
# SSH ed25519 private key
id_ed25519
# PKCS#12 bundle (TLS certs + keys)
*.p12
# GCP service-account JSON keys
*-service-account*.json
# ── /kit ──
# kit fix — secret-leak prevention
.env.local.*
.kit-audit.pending
.kit-skipped-commits.jsonl

# Full TAP report from `npm test` — written so an intermittent failure keeps its name.
.kit-test-run.tap
