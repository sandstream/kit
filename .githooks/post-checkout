#!/bin/sh
# post-checkout: give a new worktree the PreToolUse gates.
#
# The gates live in the ignored .claude/ of each checkout, so a new worktree starts without them and
# an agent working there runs ungated. `git worktree add` passes an all-zero previous HEAD ($1).
# `git worktree add --no-checkout` and `--orphan` run no hook, and a later checkout in such a
# worktree can pass its real HEAD, so the hook also acts in a linked worktree (.git is a file) that
# has no kit gate marker yet. Any other checkout leaves here at once and kit is not started. This
# directory is tracked and git resolves core.hooksPath per worktree, so committing the hook is what
# makes it run in a new one. Only case and test are used: POSIX sh, and Git for Windows' sh.
#
# kit worktree-gates mirrors the gates of a gated main checkout, and does nothing otherwise.
# A failure never fails the checkout. Without kit this is a no-op.

case "$1" in
  "") exit 0 ;;
  *[!0]*) [ -f .git ] && [ ! -e .claude/.kit-gates-installed ] || exit 0 ;;
esac

KIT="$HOME/.kit/bin/kit"
[ -x "$KIT" ] || KIT=$(command -v kit) || exit 0
"$KIT" worktree-gates || true
exit 0
